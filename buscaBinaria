 void insertionSort(long long int *V, long long int tam){
 	
 	long long int i, j, chave;
 	
 	for(i = 1; i < tam; i++){
 		chave = V[i];
 		j = i - 1;
 		while(j >= 0 && chave < V[j]){
 			V[j+1] = V[j];
 			j--;
 			comp++;
 			trocas++;
		 }
		 V[j+1] = chave;
		 trocas++;
	 }
 }
 
 long long int buscaBinaria(long long int *V, long long int tam, long long int elem){
 	
 	long long int inicio, meio, fim;
 	
 	inicio = 0;
 	fim = tam - 1;
 	while(inicio <= fim){
	 	meio = (inicio + fim) / 2; 	
			if(V[meio] != elem){
				comp1++;
				if(V[meio] > elem){
					fim = meio - 1;
				}
				else{
					inicio = meio + 1;
				}}
			else{
					printf("\nelemento encontrado na posição: ");
					 SetConsoleTextAttribute(hConsole, 14);
	    				printf("[%lld]", meio); 
					comp1++;
					break;
				}
		}
 }
